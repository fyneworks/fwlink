# fwlink Local Development Configuration
# 
# INSTRUCTIONS:
# 1. Copy this file to the PROJECT ROOT as .env (not .env.local)
# 2. Fill in the values below
# 3. See fwx/LOCAL-DEVELOPMENT.md for detailed setup guide
#
# NOTE: This is ONLY for local development
# Production uses Google Cloud Secret Manager - no .env files needed!

# Application
PORT=3000
NODE_ENV=development

# Site Configuration  
SITE_NAME=fwLink Local
DEFAULT_DOMAIN=localhost:3000
JWT_SECRET=local-development-jwt-secret-change-me

# Database Options:

# Option 1: Connect to Cloud SQL (recommended for testing with real data)
# First run: cloud-sql-proxy fynewo:europe-west4:fwlink-db-prod
DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=fwlink
DB_USER=fwlink-user
# DB_PASSWORD=your-cloud-sql-password

# Option 2: Local SQLite (easier for development)
# DB_CLIENT=better-sqlite3
# DB_FILENAME=dev-data

# Redis - Use local Redis for development
REDIS_ENABLED=false
# For local Redis: docker run -p 6379:6379 redis:alpine
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Development Settings
TRUST_PROXY=false
DISALLOW_REGISTRATION=false
DISALLOW_ANONYMOUS_LINKS=false
ENABLE_RATE_LIMIT=false
CUSTOM_DOMAIN_USE_HTTPS=false

# Email - Disable for local development
MAIL_ENABLED=false
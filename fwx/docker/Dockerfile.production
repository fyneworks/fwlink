# Multi-stage optimized Dockerfile for fwlink production deployment
# Builder stage
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev)
RUN npm ci

# Copy source code
COPY . .

# Remove dev dependencies and clean cache
RUN npm prune --omit=dev && npm cache clean --force

# Runner stage
FROM node:22-alpine AS runner

# Install Cloud SQL Auth Proxy and other runtime dependencies
RUN apk add --no-cache \
    curl \
    dumb-init \
    && curl -o cloud-sql-proxy https://storage.googleapis.com/cloud-sql-connectors/cloud-sql-proxy/v2.8.0/cloud-sql-proxy.linux.amd64 \
    && chmod +x cloud-sql-proxy \
    && mv cloud-sql-proxy /usr/local/bin/ \
    && rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S fwlink -u 1001

WORKDIR /app

# Copy built application from builder stage
COPY --from=builder --chown=fwlink:nodejs /app .

# Create data directory for potential local file storage
RUN mkdir -p /var/lib/fwlink && chown fwlink:nodejs /var/lib/fwlink

USER fwlink

EXPOSE 3000

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

# Start command with Cloud SQL proxy and app
CMD ["sh", "-c", "cloud-sql-proxy --port 5432 fynewo:europe-west4:fwlink-db & npm run migrate && npm start"]